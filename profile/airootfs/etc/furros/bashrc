[[ $- != *i* ]] && return

PS1='\[\e[38;2;127;240;240m\]🐾 \u\[\e[0m\]@\[\e[38;2;226;58;68m\]\h\[\e[0m\] \w \$ '

alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
