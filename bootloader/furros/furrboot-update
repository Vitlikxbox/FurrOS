#!/bin/bash
# furrboot-update: writes FurrBoot's menu from what is installed.
#   - every kernel in /boot (vmlinuz-NAME + initramfs-NAME.img) -> a menu entry; linux-furros is the main one
#   - "safe graphics" = the main kernel with nomodeset
#   - snapper snapshots of / that carry their own kernel -> snapshot entries (booted read-only with a tmpfs overlay)
#   - \loader\furrboot.conf: language and clock offset follow the system; timeout/theme set by the user are kept
# UEFI reads only FAT, so kernels are copied to $BOOT (bootctl's XBOOTLDR partition, or the ESP). Snapshot kernels
# are stored once per content (most snapshots share the same kernel). Only files this script wrote are ever removed.
#
# Usage: furrboot-update [--boot DIR] [--dry-run]
# Boot Loader Specification: https://uapi-group.org/specifications/specs/boot_loader_specification/
set -euo pipefail

BOOT=""; EXPLICIT=0
DRY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --boot) BOOT=$2; EXPLICIT=1; shift ;;
        --dry-run) DRY=1 ;;
        -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
        *) echo "furrboot-update: unknown option $1" >&2; exit 2 ;;
    esac
    shift
done

[ "$(id -u)" = 0 ] || [ "$DRY" = 1 ] || { echo "furrboot-update: run as root" >&2; exit 1; }
MARK="# generated by furrboot-update"
SNAPDIR=${FURRBOOT_SNAPDIR:-/.snapshots}   # tests point this elsewhere
KEEP_SNAPSHOTS=12          # newest snapshots shown in the menu
MIN_FREE_KB=$((24 * 1024))        # snapshots: leave room (Windows updates also write to a shared EFI partition)
MIN_FREE_KERNEL_KB=$((4 * 1024))  # the kernels the system boots with come first

log() { echo "furrboot-update: $*"; }
run() { if [ "$DRY" = 1 ]; then echo "  [dry] $*"; else "$@"; fi; }

# ---------- where to write ----------
if [ -z "$BOOT" ]; then
    BOOT=$(bootctl --print-boot-path 2>/dev/null || true)       # XBOOTLDR if there is one, else the ESP
    [ -n "$BOOT" ] || BOOT=$(bootctl --print-esp-path 2>/dev/null || true)
    [ -n "$BOOT" ] || for d in /efi /boot/efi /boot; do
        findmnt -no FSTYPE "$d" 2>/dev/null | grep -qx vfat && { BOOT=$d; break; }   # automount: autofs + vfat lines
    done
fi
[ -n "$BOOT" ] && [ -d "$BOOT" ] || { echo "furrboot-update: no FAT boot partition found (use --boot DIR)" >&2; exit 1; }
# Started by the pacman hook or the snapper plugin (no --boot): only when FurrBoot is actually installed. Installing
# the package on a system that still boots with GRUB must not fill its (shared, small) EFI partition with kernels.
# BIOS PCs boot Limine instead (furrboot-install --bios): the same menu is also written as limine.conf, kernels are
# always copied (Limine reads only FAT) and there is no boot counting (no EFI variables, no systemd-bless-boot).
LIMINE=0
[ -f "$BOOT/limine/limine-bios.sys" ] && LIMINE=1
if [ "$EXPLICIT" = 0 ] && [ "$LIMINE" = 1 ]; then
    ESP=$BOOT
elif [ "$EXPLICIT" = 0 ]; then
    ESP=$(bootctl --print-esp-path 2>/dev/null || echo "$BOOT")
    if [ -z "$(find "$ESP" -maxdepth 3 -ipath '*/efi/furros/furrboot.efi' -print -quit 2>/dev/null)" ]; then
        log "FurrBoot is not installed on $ESP (run furrboot-install first): nothing to do"
        exit 0
    fi
else
    ESP=$BOOT
fi
ENTRIES="$BOOT/loader/entries"
STORE="$BOOT/furrboot"
run mkdir -p "$ENTRIES" "$STORE/kernels" "$STORE/snap"

# ---------- kernels straight from the FurrOS partition (Btrfs, ext4) ----------
# /boot on Btrfs and the efifs Btrfs driver next to FurrBoot (furrboot-install puts it in \EFI\FurrOS\drivers):
# entries point at the kernels on the FurrOS partition itself — "furrboot-volume" is its GPT partition GUID and
# paths start at the top of the file system, the way GRUB's Btrfs code (which efifs is built from) sees them:
# /@/boot/vmlinuz-linux, /@snapshots/12/snapshot/boot/... Nothing is copied to the EFI partition then, so any
# number of kernels and snapshots fit next to Windows. FURRBOOT_DIRECT_PART/_PREFIX: for tests.
DIRECT=0; PARTUUID=""; BOOTPATH=""
if [ -n "${FURRBOOT_DIRECT_PART:-}" ]; then
    DIRECT=1; PARTUUID=$FURRBOOT_DIRECT_PART; BOOTPATH=${FURRBOOT_DIRECT_PREFIX:-/@/boot}
else
    # which efifs driver reads the file system /boot is on (ext2_x64.efi is GRUB's ext2/3/4 code)
    case "$(findmnt -no FSTYPE --target /boot 2>/dev/null)" in
        btrfs) DRIVER=btrfs_x64.efi ;;
        ext4|ext3|ext2) DRIVER=ext2_x64.efi ;;
        *) DRIVER="" ;;
    esac
fi
if [ "$DIRECT" = 0 ] && [ "$LIMINE" = 0 ] && [ -n "${DRIVER:-}" ] \
     && [ -n "$(find "$ESP" -maxdepth 4 -ipath "*/efi/furros/drivers/$DRIVER" -print -quit 2>/dev/null)" ]; then
    src=$(findmnt -no SOURCE --target /boot | head -1 | sed 's/\[.*//')        # /dev/nvme0n1p5[/@] -> /dev/nvme0n1p5
    # lsblk asks udev and can come back empty (loop devices, a stale udev db); blkid reads the partition table
    PARTUUID=$(lsblk -no PARTUUID "$src" 2>/dev/null | head -1)
    [ -n "$PARTUUID" ] || PARTUUID=$(blkid -s PARTUUID -o value "$src" 2>/dev/null)
    fsroot=$(findmnt -no FSROOT --target /boot | head -1)                     # /@ : the subvolume holding /boot
    rel=$(realpath --relative-to="$(findmnt -no TARGET --target /boot | head -1)" /boot)   # boot
    BOOTPATH="${fsroot%/}/$rel"; BOOTPATH=${BOOTPATH%/.}
    if [ -n "$PARTUUID" ]; then DIRECT=1; log "kernels are read from $src through $DRIVER (partition $PARTUUID, $BOOTPATH)"
    else log "can't find the GPT partition GUID of $src: kernels are copied to $BOOT"; fi
fi

# ---------- language ----------
LANG_CODE=en
if [ -r /etc/locale.conf ]; then
    l=$(sed -n 's/^LANG=//p' /etc/locale.conf | tr -d '"' | cut -c1-2)
    case "$l" in ru|en|pl|es) LANG_CODE=$l ;; esac
fi
[ -n "${FURRBOOT_LANG:-}" ] && LANG_CODE=$FURRBOOT_LANG   # tests, or a menu language other than the system's
case "$LANG_CODE" in
    ru) T_MAIN_SUB="ядро FurrOS"; T_MAIN_WHEN="для игр и рабочего стола"; T_SAFE="Безопасная графика"
        T_SNAP="Снимок"; T_SCHEDULED="по расписанию"; T_MANUAL="вручную"; T_AUTO="автоматический (snap-pac)"
        T_UPDATE="перед обновлением пакетов"; T_INSTALL="перед установкой программ"; T_REMOVE="перед удалением программ"
        T_SPARE="запасное: если что-то пошло не так"; T_LTS="долгая поддержка, для старого железа"; T_ZEN="для игр, от Zen"; T_FRESH="свежая установка FurrOS"; T_STD="Стандартное ядро" ;;
    pl) T_MAIN_SUB="jądro FurrOS"; T_MAIN_WHEN="do gier i pracy"; T_SAFE="Bezpieczna grafika"
        T_SNAP="Migawka"; T_SCHEDULED="według harmonogramu"; T_MANUAL="ręcznie"; T_AUTO="automatyczna (snap-pac)"
        T_UPDATE="przed aktualizacją pakietów"; T_INSTALL="przed instalacją programów"; T_REMOVE="przed usunięciem programów"
        T_SPARE="zapasowe: gdy coś poszło nie tak"; T_LTS="długie wsparcie, do starszego sprzętu"; T_ZEN="do gier, od Zen"; T_FRESH="świeża instalacja FurrOS"; T_STD="Standardowe jądro" ;;
    es) T_MAIN_SUB="kernel FurrOS"; T_MAIN_WHEN="para jugar y trabajar"; T_SAFE="Gráficos seguros"
        T_SNAP="Instantánea"; T_SCHEDULED="programada"; T_MANUAL="manual"; T_AUTO="automática (snap-pac)"
        T_UPDATE="antes de actualizar paquetes"; T_INSTALL="antes de instalar programas"; T_REMOVE="antes de quitar programas"
        T_SPARE="de repuesto: si algo salió mal"; T_LTS="soporte largo, para equipos antiguos"; T_ZEN="para juegos, de Zen"; T_FRESH="FurrOS recién instalado"; T_STD="Kernel estándar" ;;
    *)  T_MAIN_SUB="FurrOS kernel"; T_MAIN_WHEN="for games and the desktop"; T_SAFE="Safe graphics"
        T_SNAP="Snapshot"; T_SCHEDULED="scheduled"; T_MANUAL="manual"; T_AUTO="automatic (snap-pac)"
        T_UPDATE="before a package update"; T_INSTALL="before installing programs"; T_REMOVE="before removing programs"
        T_SPARE="spare: if something went wrong"; T_LTS="long-term support, for older hardware"; T_ZEN="for games, from Zen"; T_FRESH="FurrOS fresh install"; T_STD="Standard kernel" ;;
esac

# ---------- kernel command line ----------
# /etc/kernel/cmdline if the system has one; otherwise today's command line without loader-only and snapshot bits.
# The root subvolume always comes from fstab, so running this while booted into a snapshot still writes the right one.
if [ -s /etc/kernel/cmdline ]; then
    BASE=$(tr '\n' ' ' </etc/kernel/cmdline)
else
    BASE=""
    for a in $(cat /proc/cmdline); do
        case "$a" in
            BOOT_IMAGE=*|initrd=*|systemd.volatile=*|systemd.mask=systemd-remount-fs.service|rootflags=*) ;;
            *) BASE="$BASE $a" ;;
        esac
    done
fi
ROOT_SUBVOL=$(findmnt --fstab -no OPTIONS / 2>/dev/null | tr ',' '\n' | sed -n 's/^subvol=\/\{0,1\}//p' | head -1)
cmdline_for() { # subvolume -> options line
    local sv=$1 flags=""
    [ -n "$sv" ] && flags="subvol=$sv"
    echo "$BASE${flags:+ rootflags=$flags}" | sed 's/^ *//; s/  */ /g; s/ *$//'
}

# ---------- helpers ----------
declare -A WANT   # files under $STORE that must stay
declare -A KFAT IFAT  # kernel name -> its vmlinuz / initramfs on the FAT partition
INPLACE=0  # 1: not enough room for the new file next to the old one, overwrite it directly
copy_if_changed() { # src dst
    if [ -f "$2" ] && cmp -s "$1" "$2"; then return; fi
    if [ "$INPLACE" = 1 ]; then run cp "$1" "$2"; else run cp "$1" "$2.new" && run mv "$2.new" "$2"; fi
}
free_kb() { df -Pk "$BOOT" | awk 'NR==2 {print $4}'; }
write_entry() { # id, then lines
    local id=$1; shift
    local f="$ENTRIES/$id.conf"
    if [ "$DRY" = 1 ]; then echo "  [dry] $f:"; printf '      %s\n' "$MARK" "$@"; return; fi
    { echo "$MARK"; printf '%s\n' "$@"; } >"$f.new" && mv "$f.new" "$f"
    WROTE+=("$id.conf")
}
WROTE=()

# Boot counting (https://systemd.io/AUTOMATIC_BOOT_ASSESSMENT/): when the main kernel or its initramfs changes,
# its entry becomes "furros+3.conf". FurrBoot counts every start down; after the system comes up fine,
# systemd-bless-boot renames it back to "furros.conf". Three failed starts in a row (+0-3) and FurrBoot starts the
# spare kernel instead. Unchanged files keep whatever name they have, so a counter is never reset by accident.
TRIES=${FURRBOOT_TRIES:-$(cat /etc/kernel/tries 2>/dev/null || echo 3)}
case "$TRIES" in ''|*[!0-9]*) TRIES=3 ;; esac
[ "$LIMINE" = 1 ] && TRIES=0

# limine.conf (BIOS): Limine's font has only ASCII (code page 437), so its menu is English whatever the system
# language is. Entries are gathered here and written at the end. CONFIG.md: "/" opens an entry, "//" a sub-entry.
LIM_MAIN=(); LIM_KERNELS=(); LIM_SNAPS=()
lim_entry() { # array-name level title comment linux initrd options
    local -n arr=$1
    local slashes; slashes=$(printf '%*s' "$2" '' | tr ' ' /)
    arr+=("$slashes$3" "    comment: $4" "    protocol: linux" "    path: boot():$5" "    module_path: boot():$6"
          "    cmdline: $7" "")
}
ascii() { iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null <<<"$1" | tr -cd '[:print:]' || true; }
write_counted_entry() { # id sum, then lines
    local id=$1 sum=$2; shift 2
    local old="" name f o
    for f in "$ENTRIES/$id.conf" "$ENTRIES/$id"+*.conf; do [ -f "$f" ] && { old=$f; break; }; done
    if [ -n "$old" ] && grep -qxF "furrboot-sum $sum" "$old"; then
        name=${old##*/}                                   # same kernel as before: keep its counter
    elif [ "$TRIES" -gt 0 ]; then
        name="$id+$TRIES.conf"; log "new kernel for $id: $TRIES boot tries until it is confirmed"
    else
        name="$id.conf"
    fi
    f="$ENTRIES/$name"
    if [ "$DRY" = 1 ]; then echo "  [dry] $f:"; printf '      %s\n' "$MARK" "$@" "furrboot-sum $sum"; return; fi
    { echo "$MARK"; printf '%s\n' "$@" "furrboot-sum $sum"; } >"$f.new" && mv "$f.new" "$f"
    for o in "$ENTRIES/$id.conf" "$ENTRIES/$id"+*.conf; do  # the other spellings of this entry
        [ -f "$o" ] && [ "$o" != "$f" ] && head -1 "$o" | grep -qxF "$MARK" && rm -f "$o"
    done
    WROTE+=("$name")
}

# ---------- kernels ----------
MAIN=""
KERNELS=()
for v in /boot/vmlinuz-*; do
    [ -f "$v" ] || continue
    k=${v#/boot/vmlinuz-}
    [ -f "/boot/initramfs-$k.img" ] || { log "skip $k: no initramfs"; continue; }
    KERNELS+=("$k")
done
[ ${#KERNELS[@]} -gt 0 ] || { echo "furrboot-update: no kernels in /boot" >&2; exit 1; }
# the main entry: the kernel picked in the installer (KERNEL= in /etc/furros/settings.conf) if it is installed,
# else the FurrOS kernel, else the first one. FURRBOOT_MAIN: for tests
WANT_MAIN=${FURRBOOT_MAIN:-$(sed -n 's/^KERNEL=//p' /etc/furros/settings.conf 2>/dev/null | head -1 || true)}
for k in "${KERNELS[@]}"; do [ "$k" = linux-furros ] && MAIN=$k; done
for k in "${KERNELS[@]}"; do [ -n "$WANT_MAIN" ] && [ "$k" = "$WANT_MAIN" ] && MAIN=$k; done
[ -n "$MAIN" ] || MAIN=${KERNELS[0]}

OPTS=$(cmdline_for "$ROOT_SUBVOL")
sort=20
for k in "${KERNELS[@]}"; do
    if [ "$DIRECT" = 1 ]; then
        common=("linux $BOOTPATH/vmlinuz-$k" "initrd $BOOTPATH/initramfs-$k.img" "furrboot-volume $PARTUUID")
    elif [ "$(realpath "$BOOT")" = /boot ]; then
        # /boot is the FAT partition itself: the kernels already sit where the firmware can read them
        common=("linux /vmlinuz-$k" "initrd /initramfs-$k.img")
        KFAT[$k]=/boot/vmlinuz-$k; IFAT[$k]=/boot/initramfs-$k.img
    else
        # room check first: on a small EFI partition shared with Windows a half-copied kernel must not happen
        # need: the new files; old: what the files they replace take now (freed if overwritten in place)
        need=0; old=0; INPLACE=0
        for pair in "vmlinuz-$k:vmlinuz" "initramfs-$k.img:initramfs.img"; do
            src=/boot/${pair%%:*}; dst=$STORE/kernels/$k/${pair#*:}
            cmp -s "$src" "$dst" 2>/dev/null && continue
            need=$((need + $(du -k "$src" | cut -f1)))
            [ -f "$dst" ] && old=$((old + $(du -k "$dst" | cut -f1)))
        done
        if [ "$need" -gt 0 ] && [ $(( $(free_kb) - need )) -lt "$MIN_FREE_KERNEL_KB" ]; then
            if [ $(( $(free_kb) + old - need )) -ge "$MIN_FREE_KERNEL_KB" ]; then
                # a 100+ MiB initramfs (NVIDIA) on a 200 MiB EFI partition shared with Windows: no room for two copies
                INPLACE=1; log "$k: little room on $BOOT, replacing its files in place"
            else
                echo "furrboot-update: not enough room on $BOOT for $k ($((need / 1024)) MiB needed, $(( $(free_kb) / 1024 )) MiB free)." >&2
                echo "furrboot-update: nothing was changed for it; the menu keeps the files it had." >&2
                exit 1
            fi
        fi
        run mkdir -p "$STORE/kernels/$k"
        copy_if_changed "/boot/vmlinuz-$k" "$STORE/kernels/$k/vmlinuz"
        copy_if_changed "/boot/initramfs-$k.img" "$STORE/kernels/$k/initramfs.img"
        WANT["kernels/$k/vmlinuz"]=1; WANT["kernels/$k/initramfs.img"]=1
        common=("linux /furrboot/kernels/$k/vmlinuz" "initrd /furrboot/kernels/$k/initramfs.img")
        KFAT[$k]=$STORE/kernels/$k/vmlinuz; IFAT[$k]=$STORE/kernels/$k/initramfs.img
    fi
    if [ "$k" = "$MAIN" ]; then
        case "$k" in linux-furros) sub=$T_MAIN_SUB ;; linux) sub=$T_STD ;; *) sub=$k ;; esac
        sum=$(cat "/boot/vmlinuz-$k" "/boot/initramfs-$k.img" | sha256sum | cut -c1-16)
        write_counted_entry furros "$sum" "title FurrOS" "${common[@]}" "options $OPTS" "sort-key 10" \
            "furrboot-kind main" "furrboot-subtitle $sub" "furrboot-when $T_MAIN_WHEN"
        write_entry safe-graphics "title $T_SAFE" "${common[@]}" "options $OPTS nomodeset" "sort-key 90" "furrboot-kind safe"
        lim_entry LIM_MAIN 1 "FurrOS" "$k - for games and the desktop" "${common[0]#linux }" "${common[1]#initrd }" "$OPTS"
        lim_entry LIM_MAIN 1 "FurrOS - safe graphics" "black screen? this one starts without the graphics driver (nomodeset)" \
            "${common[0]#linux }" "${common[1]#initrd }" "$OPTS nomodeset"
        continue  # the kernels screen lists the main entry itself
    fi
    case "$k" in
        linux) title=$T_STD; when=$T_SPARE; ewhen="spare: if something went wrong" ;;
        linux-lts) title="Linux LTS"; when=$T_LTS; ewhen="long-term support, for older hardware" ;;
        linux-zen) title="Linux Zen"; when=$T_ZEN; ewhen="for games, from Zen" ;;
        linux-furros) title="FurrOS"; when=$T_MAIN_WHEN; ewhen="for games and the desktop" ;;
        *) title=$k; when=""; ewhen=$k ;;
    esac
    write_entry "kernel-$k" "title $title" "${common[@]}" "options $OPTS" "sort-key $sort" \
        "furrboot-kind kernel" ${when:+"furrboot-when $when"}
    etitle=$title; [ "$k" = linux ] && etitle="Standard kernel"
    lim_entry LIM_KERNELS 2 "$(ascii "$etitle") ($k)" "$ewhen" "${common[0]#linux }" "${common[1]#initrd }" "$OPTS"
    sort=$((sort + 1))
done

# ---------- snapshots ----------
# Inside the installer's chroot snapper must work on its own (--no-dbus, snapper(8)): arch-chroot shares /run
# with the live system, so its D-Bus answers there, but that snapperd knows nothing about the new system's config.
SNAPPER=(snapper)
if command -v snapper >/dev/null && ! snapper -c root get-config >/dev/null 2>&1; then SNAPPER=(snapper --no-dbus); fi
if command -v snapper >/dev/null && "${SNAPPER[@]}" -c root get-config >/dev/null 2>&1; then
    # number, pre-number (set on "post" snapshots), date (ISO), cleanup, userdata, description. Not tab-separated:
    # read merges runs of whitespace separators, so empty columns would vanish. The description goes last, so a "|"
    # inside it just stays part of it.
    mapfile -t SNAPS < <("${SNAPPER[@]}" --csvout --no-headers --separator '|' -c root list --disable-used-space \
        --columns number,pre-number,date,cleanup,userdata,description 2>/dev/null | tac)
    shown=0
    for line in "${SNAPS[@]}"; do
        IFS='|' read -r num pre date cleanup userdata desc <<<"$line"
        [ "$num" = 0 ] && continue          # 0 is "current", not a snapshot
        [ -n "$pre" ] && continue           # "post" halves of pre/post pairs duplicate their "pre"
        [ "$shown" -ge "$KEEP_SNAPSHOTS" ] && break
        desc=${desc#\"}; desc=${desc%\"}; desc=${desc//\"\"/\"}
        dir=$SNAPDIR/$num/snapshot
        sk=""
        for v in "$dir"/boot/vmlinuz-*; do
            [ -f "$v" ] || continue
            sk=${v#"$dir"/boot/vmlinuz-}
            [ "$sk" = "$MAIN" ] && break
        done
        if [ -z "$sk" ] || [ ! -f "$dir/boot/initramfs-$sk.img" ]; then
            log "snapshot $num has no kernel of its own, not in the menu"; continue
        fi
        # the subvolume path relative to the top of the filesystem, e.g. @snapshots/12/snapshot
        sv=$(btrfs subvolume show "$dir" 2>/dev/null | head -1 | sed 's#^/##')
        [ -n "$sv" ] || { log "snapshot $num: can't find its subvolume"; continue; }
        # a snapshot taken since the last kernel update has the very files the menu already holds for that kernel:
        # point at those instead of copying them again (it matters on a 100-200 MiB EFI partition)
        kpath=""; ipath=""; need=0; volline=""
        if [ "$DIRECT" = 1 ]; then
            # straight from the snapshot's own subvolume: nothing to copy, any number of snapshots
            kpath="/$sv/boot/vmlinuz-$sk"; ipath="/$sv/boot/initramfs-$sk.img"; volline="furrboot-volume $PARTUUID"
        fi
        if [ -z "$kpath" ] && [ -n "${KFAT[$sk]:-}" ] && cmp -s "$dir/boot/vmlinuz-$sk" "${KFAT[$sk]}"; then kpath=${KFAT[$sk]#"$BOOT"}; fi
        if [ -z "$ipath" ] && [ -n "${IFAT[$sk]:-}" ] && cmp -s "$dir/boot/initramfs-$sk.img" "${IFAT[$sk]}"; then ipath=${IFAT[$sk]#"$BOOT"}; fi
        if [ -z "$kpath" ]; then
            hk=$(sha256sum "$dir/boot/vmlinuz-$sk" | cut -c1-16); kpath=/furrboot/snap/$hk.vmlinuz
            [ -f "$BOOT$kpath" ] || need=$((need + $(du -k "$dir/boot/vmlinuz-$sk" | cut -f1)))
        fi
        if [ -z "$ipath" ]; then
            hi=$(sha256sum "$dir/boot/initramfs-$sk.img" | cut -c1-16); ipath=/furrboot/snap/$hi.img
            [ -f "$BOOT$ipath" ] || need=$((need + $(du -k "$dir/boot/initramfs-$sk.img" | cut -f1)))
        fi
        if [ "$need" -gt 0 ] && [ $(( $(free_kb) - need )) -lt "$MIN_FREE_KB" ]; then
            log "boot partition is full: older snapshots stay out of the menu"; break
        fi
        case "$kpath" in /furrboot/snap/*) [ -f "$BOOT$kpath" ] || run cp "$dir/boot/vmlinuz-$sk" "$BOOT$kpath"; WANT["${kpath#/furrboot/}"]=1 ;; esac
        case "$ipath" in /furrboot/snap/*) [ -f "$BOOT$ipath" ] || run cp "$dir/boot/initramfs-$sk.img" "$BOOT$ipath"; WANT["${ipath#/furrboot/}"]=1 ;; esac

        tag=""; typ=$T_MANUAL; sub=$desc; esub=$(ascii "$desc")
        case "$cleanup" in timeline) typ=$T_SCHEDULED; sub=$T_SCHEDULED; esub=scheduled ;; esac
        case "$desc" in
            # the installer's last snapshot (ASCII on purpose, see backend.py)
            "FurrOS: fresh install") sub=$T_FRESH; esub="FurrOS fresh install" ;;
            *pacman*-Syu*|*pacman*-Su*) tag=update; typ=$T_AUTO; sub=$T_UPDATE; esub="before a package update" ;;
            *pacman*-S*|*pacman*-U*)    tag=install; typ=$T_AUTO; sub=$T_INSTALL; esub="before installing programs" ;;
            *pacman*-R*)                typ=$T_AUTO; sub=$T_REMOVE; esub="before removing programs" ;;
        esac
        lim_entry LIM_SNAPS 2 "Snapshot $num - ${date:0:16}" "${esub:-snapshot} (read-only: changes are gone after a reboot)" \
            "$kpath" "$ipath" "$(cmdline_for "$sv") systemd.volatile=overlay systemd.mask=systemd-remount-fs.service"
        case ",$userdata," in *,important=yes,*) tag=important ;; esac
        write_entry "snapshot-$num" "title $T_SNAP $num" "linux $kpath" "initrd $ipath" ${volline:+"$volline"} \
            "options $(cmdline_for "$sv") systemd.volatile=overlay systemd.mask=systemd-remount-fs.service" \
            "sort-key 50" "furrboot-kind snapshot" "furrboot-date ${date:0:16}" "furrboot-subtitle $sub" \
            ${tag:+"furrboot-tag $tag"} "furrboot-kernel $sk" "furrboot-type $typ"
        shown=$((shown + 1))
    done
fi

# ---------- clean up what we wrote before and no longer need ----------
if [ "$DRY" = 0 ]; then
    for f in "$ENTRIES"/*.conf; do
        [ -f "$f" ] || continue
        head -1 "$f" | grep -qxF "$MARK" || continue        # not ours: never touch
        keep=0; for w in "${WROTE[@]}"; do [ "$(basename "$f")" = "$w" ] && keep=1; done
        [ "$keep" = 1 ] || { rm -f "$f"; log "removed old entry $(basename "$f")"; }
    done
    while IFS= read -r -d '' f; do
        rel=${f#"$STORE"/}
        [ -n "${WANT[$rel]:-}" ] || { rm -f "$f"; log "removed $rel"; }
    done < <(find "$STORE/kernels" "$STORE/snap" -type f -print0)
    find "$STORE/kernels" -mindepth 1 -type d -empty -delete
fi

# ---------- furrboot.conf ----------
# the firmware clock: UTC unless the system keeps it in local time (dual boot with Windows does)
TZ_MIN=0
if [ "$(timedatectl show -p LocalRTC --value 2>/dev/null)" != yes ]; then
    z=$(date +%z); h=$((10#${z:1:2})); m=$((10#${z:3:2}))
    TZ_MIN=$((h * 60 + m)); [ "${z:0:1}" = - ] && TZ_MIN=$((-TZ_MIN))
fi
CONF="$BOOT/loader/furrboot.conf"
set_key() { # key value: replace the line or add it
    if [ "$DRY" = 1 ]; then echo "  [dry] $CONF: $1 $2"; return; fi
    touch "$CONF"
    if grep -qE "^$1([[:space:]]|$)" "$CONF"; then sed -i -E "s|^$1([[:space:]].*)?$|$1 $2|" "$CONF"; else echo "$1 $2" >>"$CONF"; fi
}
[ "$DRY" = 1 ] || [ -f "$CONF" ] || printf '# FurrBoot settings (timeout, theme, resolution are yours; lang and tz-offset follow the system)\ntimeout 10\ndefault furros\n' >"$CONF"
set_key lang "$LANG_CODE"
set_key tz-offset "$TZ_MIN"

# ---------- limine.conf (BIOS) ----------
# FurrOS colours: CONFIG.md "Global options". The wallpaper leaves the left part dark for the menu.
if [ "$LIMINE" = 1 ]; then
    LCONF="$BOOT/limine/limine.conf"
    {
        echo "$MARK"
        echo "# FurrOS boot menu for PCs without UEFI. Rewritten after every kernel update and snapshot:"
        echo "# change timeout here, everything else comes from furrboot-update."
        t=$(sed -n 's/^timeout:[[:space:]]*//p' "$LCONF" 2>/dev/null | head -1 || true)
        echo "timeout: ${t:-10}"
        echo "default_entry: 1"
        echo "interface_branding: FurrOS  -  good dogs only"
        echo "interface_branding_colour: ff5577"
        echo "interface_help_colour: 7ff0f0"
        echo "interface_help_colour_bright: c8ffff"
        [ -f "$BOOT/limine/furros.png" ] && { echo "wallpaper: boot():/limine/furros.png"; echo "wallpaper_style: stretched"; }
        echo "term_background: b01e1218"
        echo "term_foreground: f5e6ea"
        echo "term_foreground_bright: ffffff"
        echo "term_palette: 1e1218;ff5577;8ff0a4;ffd479;7fb7ff;ff8fc8;7ff0f0;d8c8cc"
        echo "term_palette_bright: 4a3640;ff7f9a;b0ffc4;ffe6a0;a8ceff;ffb3dc;b8ffff;ffffff"
        echo "term_margin: 48"
        echo "term_margin_gradient: 8"
        echo ""
        printf '%s\n' "${LIM_MAIN[@]}"
        if [ ${#LIM_KERNELS[@]} -gt 0 ]; then echo "/Other kernels"; echo "    comment: the spare kernel, if the main one won't start"; printf '%s\n' "${LIM_KERNELS[@]}"; fi
        if [ ${#LIM_SNAPS[@]} -gt 0 ]; then echo "/System snapshots"; echo "    comment: boot the system as it was before an update"; printf '%s\n' "${LIM_SNAPS[@]}"; fi
    } > "$LCONF.new"
    if [ "$DRY" = 1 ]; then echo "  [dry] $LCONF:"; sed 's/^/      /' "$LCONF.new"; rm -f "$LCONF.new"
    else mv "$LCONF.new" "$LCONF"; log "Limine menu written to $LCONF"; fi
fi
log "menu updated in $BOOT: ${#KERNELS[@]} kernel(s), ${shown:-0} snapshot(s)"
